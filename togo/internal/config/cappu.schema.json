{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "compilerOptions": {
      "default": {},
      "type": "object",
      "properties": {
        "classPath": {
          "default": [
            "./.cappu/lib/classes",
            "./target/dependency",
            "./build/libs",
            "./lib",
            "./libs"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourcePaths": {
          "default": [
            "./src/main/java",
            "./src/generated/java"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resourcePaths": {
          "default": [
            "./src/main/resources"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "output": {
          "default": "classes",
          "type": "string",
          "enum": [
            "classes",
            "jar",
            "fat-jar"
          ]
        },
        "javac": {
          "default": "javac",
          "type": "string"
        },
        "javacOptions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "release": {
          "type": "integer",
          "minimum": 8,
          "maximum": 9007199254740991
        },
        "mainClass": {
          "type": "string"
        },
        "experimentalCompiler": {
          "default": {},
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "failOnDegrade": {
              "default": true,
              "type": "boolean"
            },
            "validate": {
              "default": false,
              "type": "boolean"
            },
            "debugInfo": {
              "default": false,
              "type": "boolean"
            }
          }
        },
        "nullness": {
          "type": "object",
          "properties": {
            "enabled": {
              "default": false,
              "type": "boolean"
            },
            "nullableAnnotations": {
              "default": [
                "org.jspecify.annotations.Nullable"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nonNullAnnotations": {
              "default": [
                "org.jspecify.annotations.NonNull"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nullMarkedAnnotations": {
              "default": [
                "org.jspecify.annotations.NullMarked"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "nullUnmarkedAnnotations": {
              "default": [
                "org.jspecify.annotations.NullUnmarked"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "lspOptions": {
      "default": {},
      "type": "object",
      "properties": {
        "inlayHints": {
          "type": "object",
          "properties": {
            "parameterNames": {
              "default": true,
              "type": "boolean"
            },
            "varTypes": {
              "default": true,
              "type": "boolean"
            }
          }
        }
      }
    },
    "dapOptions": {
      "default": {},
      "type": "object",
      "properties": {
        "enableAssertions": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "formatterOptions": {
      "default": {},
      "type": "object",
      "properties": {
        "style": {
          "default": "google",
          "type": "string",
          "enum": [
            "google",
            "aosp"
          ]
        },
        "ignore": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "importOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(|[^*]*\\*)$"
          }
        }
      }
    },
    "testOptions": {
      "default": {},
      "type": "object",
      "properties": {
        "outputFormat": {
          "default": "text",
          "type": "string",
          "enum": [
            "text",
            "junit"
          ]
        },
        "reportsDir": {
          "default": "./dist/test-results",
          "type": "string"
        },
        "coverage": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "auditOptions": {
      "default": {},
      "type": "object",
      "properties": {
        "ignore": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "packageSources": {
      "description": "maven2 repositories, consulted in order. A string is an anonymous URL; an object adds \"auth\", the NAME of the env vars CAPPU_SOURCE_NAME_USERNAME + CAPPU_SOURCE_NAME_PASSWORD or CAPPU_SOURCE_NAME_TOKEN. A file:// URL or a filesystem path (~/.m2/repository) is a local repository.",
      "default": [
        "https://maven-central-eu.storage-download.googleapis.com/maven2",
        "https://repo.maven.apache.org/maven2",
        "https://maven.google.com",
        "https://plugins.gradle.org/m2"
      ],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "auth": {
                "description": "Env var name part for the credentials: CAPPU_SOURCE_<auth>_USERNAME + _PASSWORD, or _TOKEN.",
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "dependencies": {
      "default": {},
      "type": "object",
      "properties": {
        "platform": {
          "description": "BOMs (\"group:artifact\": version) whose dependencyManagement supplies the versions of entries declared as \"\" and overrides transitive versions. When two platforms manage the same artifact, the first declared wins.",
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "api": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dependency"
          }
        },
        "implementation": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dependency"
          }
        },
        "compileOnly": {
          "description": "On the compile classpath only (Maven provided): never in a fat jar, a run, or the published runtime scope.",
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dependency"
          }
        },
        "runtimeOnly": {
          "description": "Never on the compile classpath (Maven runtime): drivers and implementations loaded by name.",
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dependency"
          }
        },
        "annotationProcessor": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dependency"
          }
        },
        "testImplementation": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "jdk": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "groupId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "publishRepository": {
      "type": "string",
      "format": "uri"
    }
  },
  "$defs": {
    "dependency": {
      "description": "A version (\"\" when a platform manages it), or an object for a classifier and/or exclusions.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "version": {
              "description": "Omit (or \"\") to take the version from a platform.",
              "type": "string"
            },
            "classifier": {
              "type": "string"
            },
            "exclude": {
              "description": "\"group:artifact\" patterns pruned from this dependency's transitive subtree; either side may be *.",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
